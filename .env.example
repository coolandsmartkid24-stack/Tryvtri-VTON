# =============================================================================
# TryVtri — FASHN VTON 1.5 — environment template
# Copy to ".env" and fill in real values. NEVER commit a real ".env".
# Every value below is a placeholder.
# =============================================================================

# ---------------------------------------------------------------- backend ---
# Public base URL of this FastAPI backend (no trailing slash).
# Used by the storefront widget when it is not given an explicit API base.
TRYVTRI_PUBLIC_URL=http://localhost:8000

# Set to "production" to enable strict CORS / security headers.
ENVIRONMENT=development

# Shared secret used to sign admin JWTs. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

# Admin bootstrap. On first start, if the admin_users table is empty the
# backend creates this account. Leave ADMIN_PASSWORD empty to skip bootstrap
# (then create the account with scripts/bootstrap_admin.py).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------- supabase ---
# Project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Publishable (anon) key — safe for the browser, used for RLS-guarded reads.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret (service-role) key — backend only. NEVER expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional direct PostgreSQL connection string (used only by migration scripts).
# SUPABASE_DB_URL=postgresql://postgres:password@db.<ref>.supabase.co:5432/postgres

# ------------------------------------------------------------------- lium ----
# API key from https://lium.io/api-keys  (X-API-Key header). Backend only.
LIUM_API_KEY=
LIUM_API_BASE=https://lium.io/api

# GPU we are allowed to rent. Keep the price ceiling tight.
LIUM_GPU_TYPE=RTX 5080
LIUM_MAX_PRICE_PER_GPU_HOUR=0.45
LIUM_GPU_COUNT=1
LIUM_MIN_VRAM_GB=16

# Lium template id whose image already contains the try-on inference service,
# the FASHN weights and the CUDA PyTorch stack. Required for a real rental.
# Create one in the Lium dashboard (Templates) — see docs/GPU_DEPLOYMENT.md
LIUM_TEMPLATE_ID=

# Pod name prefix. Pods are named "<prefix>-<short-id>".
LIUM_POD_NAME_PREFIX=tryvtri-vton

# Hard safety net: never keep a pod longer than this (hours). 1..720.
LIUM_TERMINATION_HOURS=2

# Public host:port that the inference service inside the pod is reachable on.
# Leave empty to auto-read it from the pod's ports_mapping for INFERENCE_PORT.
LIUM_INFERENCE_HOST=
# Internal port the inference service listens on INSIDE the pod.
# The production pod runs the IDM-VTON multi-category API on 8888 (externally
# mapped, e.g. 40398 on the pod's public host; the mapped port moves on restart).
LIUM_INFERENCE_PORT=8888

# Idle policy: shut the pod down after this many seconds with no active or
# queued inference request.
GPU_IDLE_SHUTDOWN_SECONDS=600

# How long to wait for a freshly rented pod to become healthy (seconds).
GPU_STARTUP_TIMEOUT_SECONDS=600

# Cost guard: estimated USD spend per day after which the manager refuses to
# rent another pod (0 = disabled).
GPU_DAILY_SPEND_CAP_USD=0

# Compliance guard: when "true", every GPU start attempt is refused with a
# clear error and zero spend (use while licensing for the model weights is not
# yet confirmed for commercial use). Set to "false" to re-enable the GPU.
GPU_CALL_PAUSED=false

# ------------------------------------------------------------- inference ----
# Base URL of a *running* inference service. When set, the backend uses it
# directly and never rents a GPU (useful for local development / testing).
# Leave empty to use the Lium on-demand manager.
INFERENCE_BASE_URL=
INFERENCE_TIMEOUT_SECONDS=180

# --------------------------------------------------------------- uploads ----
MAX_UPLOAD_BYTES=8388608
MAX_GARMENT_DOWNLOAD_BYTES=15728640
IMAGE_DOWNLOAD_TIMEOUT_SECONDS=20
TEMP_IMAGE_TTL_SECONDS=900

# Comma separated extra allowed image hosts (see ALLOWED_IMAGE_HOST_SUFFIXES
# in backend/app/config.py for the built-in Shopify/CDN list).
EXTRA_ALLOWED_IMAGE_HOSTS=

# ----------------------------------------------------------------- quota -----
FREE_TRIES_PER_DAY=2
QUOTA_WINDOW_HOURS=24

# ------------------------------------------------------------------ cors -----
# Origins allowed to call the storefront endpoints. "*" is safe here because
# those routes never use cookies (admin routes use Bearer tokens).
ALLOWED_ORIGINS=*

# ----------------------------------------------------------------- logging ----
LOG_LEVEL=INFO
