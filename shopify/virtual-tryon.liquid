{%- comment %}
  TryVtri Virtual Try-On — Shopify Custom Liquid block (fal.ai powered)
  Paste into: Shopify Theme Editor > Product page > Add block > Custom Liquid

  Why fal.ai instead of the local GPU backend:
  - The local tryvtri-vton.vercel.app backend runs IDM-VTON on a GPU that is
    administratively paused ("commercial-use licensing pending").
  - This block calls /api/try-on, a Vercel serverless proxy that runs
    fal-ai/flux-2-lora-gallery/virtual-tryon on fal's cloud GPUs.
    No local GPU needed. FAL_KEY stays server-side (never in the browser).

  Features:
  1. Category detected per product (override with tag: vto:dresses).
     Allowed: tops, bottoms, dresses, outerwear, accessories
  2. Price + currency passed to the widget.
  3. Selected variant / garment image stay in sync with option changes.
  4. Customer photo is never stored or written into page HTML (privacy).
  5. Customer email is not collected by the widget.
{%- endcomment -%}

{%- assign vto_api_root = '' -%} {%- comment %} same-origin proxy: /api/try-on {% endcomment -%}

{%- assign vto_variant = product.selected_or_first_available_variant -%}

{%- comment %} ---- Category detection ---- {% endcomment -%}
{%- assign vto_category = '' -%}
{%- for tag in product.tags -%}
  {%- assign tag_l = tag | downcase -%}
  {%- if tag_l contains 'vto:' -%}
    {%- assign vto_category = tag_l | remove: 'vto:' | strip -%}
  {%- endif -%}
{%- endfor -%}

{%- if vto_category == '' -%}
  {%- capture vto_haystack -%}{{ product.type }} {{ product.title }} {{ product.tags | join: ' ' }}{%- endcapture -%}
  {%- assign vto_haystack = vto_haystack | downcase -%}
  {%- if vto_haystack contains 'sunglass' or vto_haystack contains 'glasses' or vto_haystack contains 'eyewear' or vto_haystack contains 'hat' or vto_haystack contains 'cap' or vto_haystack contains 'jewel' or vto_haystack contains 'necklace' or vto_haystack contains 'earring' -%}
    {%- assign vto_category = 'accessories' -%}
  {%- elsif vto_haystack contains 'dress' or vto_haystack contains 'gown' or vto_haystack contains 'jumpsuit' or vto_haystack contains 'maxi' -%}
    {%- assign vto_category = 'dresses' -%}
  {%- elsif vto_haystack contains 'jacket' or vto_haystack contains 'coat' or vto_haystack contains 'blazer' or vto_haystack contains 'hoodie' -%}
    {%- assign vto_category = 'outerwear' -%}
  {%- elsif vto_haystack contains 'pant' or vto_haystack contains 'jean' or vto_haystack contains 'skirt' or vto_haystack contains 'short' or vto_haystack contains 'trouser' -%}
    {%- assign vto_category = 'bottoms' -%}
  {%- else -%}
    {%- assign vto_category = 'tops' -%}
  {%- endif -%}
{%- endif -%}

{%- comment %} ---- Initial garment image (selected variant / product) ---- {% endcomment -%}
{%- assign vto_garment_url = '' -%}
{%- if vto_variant.featured_image -%}
  {%- assign vto_garment_url = vto_variant.featured_image | image_url: width: 1024 -%}
{%- elsif product.featured_image -%}
  {%- assign vto_garment_url = product.featured_image | image_url: width: 1024 -%}
{%- endif -%}

{%- comment %} ---- Variant context JSON (synced by JS) ---- {% endcomment -%}
<script type="application/json" data-tv-product-context>
  {
    "productId": {{ product.id | json }},
    "productTitle": {{ product.title | json }},
    "productUrl": {{ shop.url | append: product.url | json }},
    "featuredImageUrl": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 1024 | json }}{%- else -%}null{%- endif -%},
    "selectedVariantId": {{ vto_variant.id | json }},
    "selectedVariantTitle": {{ vto_variant.title | json }},
    "category": {{ vto_category | json }},
    "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
    "price": {{ vto_variant.price | money_without_currency | strip_html | json }},
    "priceFormatted": {{ vto_variant.price | money | strip_html | json }},
    "garmentUrl": {%- if vto_garment_url -%}{{ vto_garment_url | json }}{%- else -%}null{%- endif -%},
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "price": {{ variant.price | json }},
          "priceFormatted": {{ variant.price | money | strip_html | json }},
          "available": {{ variant.available | json }},
          "imageUrl": {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 1024 | json }}{%- elsif product.featured_image -%}{{ product.featured_image | image_url: width: 1024 | json }}{%- else -%}null{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
</script>

<link rel="stylesheet" href="{{ 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css' }}">

<div class="tv-card" data-tryvtri id="tv-card-{{ product.id }}"
     style="--tv-bg:#ffffff;--tv-title-c:#0f172a;--tv-desc-c:#475569;--tv-primary:#16130f;--tv-accent:#2563eb;--tv-border:#cbd5e1;margin:20px 0;border-radius:12px;border:1px solid var(--tv-border);box-shadow:0 4px 6px -1px rgba(0,0,0,0.05);overflow:hidden;max-width:640px;"
     data-tv-platform="shopify"
     data-tv-product-id="{{ product.id }}"
     data-tv-product-title="{{ product.title | escape }}"
     data-tv-product-url="{{ shop.url }}{{ product.url }}"
     data-tv-garment-url="{{ vto_garment_url | escape }}"
     data-tv-variant-id="{{ vto_variant.id }}"
     data-tv-category="{{ vto_category }}"
     data-tv-price="{{ vto_variant.price | money_without_currency | strip_html | escape }}"
     data-tv-price-cents="{{ vto_variant.price }}"
     data-tv-price-formatted="{{ vto_variant.price | money | strip_html | escape }}"
     data-tv-currency="{{ cart.currency.iso_code | default: shop.currency }}"
     data-tv-endpoint="/api/try-on">

  <div class="tv-header" style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:var(--tv-bg);border-bottom:1px solid var(--tv-border);">
    <div style="display:flex;align-items:center;gap:12px;">
      <div class="tv-ico" style="display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:10px;background:var(--tv-accent);color:#fff;box-shadow:0 2px 4px rgba(37,99,235,0.3);">
        <i class="fa-solid fa-shirt" style="font-size:18px;"></i>
      </div>
      <div>
        <div class="tv-t1" style="font-size:16px;font-weight:700;color:var(--tv-title-c);letter-spacing:-0.02em;">Try It On Me</div>
        <div class="tv-t2" style="font-size:13px;color:var(--tv-desc-c);">See this {{ vto_category }} on your photo in seconds</div>
      </div>
    </div>
    <span class="tv-badge" style="font-size:11px;font-weight:600;color:var(--tv-accent);background:#eff6ff;border-radius:6px;padding:2px 8px;text-transform:uppercase;letter-spacing:0.04em;">fal.ai powered</span>
  </div>

  <div class="tv-body" style="padding:20px;display:flex;flex-direction:column;gap:14px;background:var(--tv-bg);">
    {%- comment %} Photo upload {% endcomment -%}
    <div class="tv-upload-section" style="display:flex;flex-direction:column;gap:10px;">
      <label class="tv-label" style="font-size:13px;font-weight:600;color:var(--tv-title-c);">Your photo</label>
      <div class="tv-dropzone" id="tv-dropzone-{{ product.id }}"
           style="border:2px dashed #cbd5e1;border-radius:10px;background:#f8fafc;min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;color:#64748b;font-size:14px;transition:all 0.2s;">
        <i class="fa-solid fa-cloud-arrow-up" style="font-size:32px;margin-bottom:8px;color:#94a3b8;"></i>
        <div style="font-weight:500;color:#334155;">Click to upload your photo</div>
        <div style="font-size:12px;color:#94a3b8;">JPG or PNG, max 8MB</div>
        <input type="file" id="tv-file-input-{{ product.id }}" accept="image/jpeg,image/png" style="display:none;">
      </div>
      <div id="tv-preview-{{ product.id }}" style="display:none;margin-top:8px;">
        <img id="tv-preview-img-{{ product.id }}" style="width:100%;max-height:240px;border-radius:8px;border:1px solid var(--tv-border);object-fit:cover;">
        <button type="button" id="tv-remove-photo-{{ product.id }}" style="margin-top:6px;padding:4px 10px;background:#fee2e2;color:#dc2626;border:none;border-radius:6px;font-size:12px;cursor:pointer;">Remove</button>
      </div>
    </div>

    {%- comment %} Controls {% endcomment -%}
    <div class="tv-controls" style="display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;">
      <div class="tv-info" style="font-size:12px;color:#64748b;background:#f1f5f9;padding:8px 12px;border-radius:8px;border:1px solid #e2e8f0;">
        <span style="font-weight:600;color:#0f172a;">Garment:</span> <span id="tv-garment-name-{{ product.id }}">{{ vto_variant.title | escape }}</span><br>
        <span style="font-weight:600;color:#0f172a;">Price:</span> <span id="tv-garment-price-{{ product.id }}">{{ vto_variant.price | money }}</span>
      </div>
      <button class="tv-try-button" id="tv-try-button-{{ product.id }}"
              style="background:var(--tv-primary);color:#fff;border:none;border-radius:8px;padding:12px 22px;font-size:15px;font-weight:700;cursor:pointer;box-shadow:0 4px 6px -1px rgba(22,19,15,0.2);min-width:140px;disabled:opacity:0.5;disabled:cursor:not-allowed;">
        <span id="tv-button-text-{{ product.id }}">Generate Try-On</span>
      </button>
    </div>

    {%- comment %} Status / result {% endcomment -%}
    <div id="tv-status-{{ product.id }}" style="font-size:13px;color:#64748b;min-height:20px;"></div>
    <div id="tv-result-container-{{ product.id }}" style="display:none;text-align:center;margin-top:12px;">
      <img id="tv-result-img-{{ product.id }}" style="max-width:100%;border-radius:10px;border:1px solid var(--tv-border);box-shadow:0 10px 15px -3px rgba(0,0,0,0.1);">
      <div style="margin-top:8px;">
        <a id="tv-download-link-{{ product.id }}" href="#" download="tryvtri-result.png" style="color:var(--tv-accent);text-decoration:none;font-size:13px;font-weight:500;">Download result &rarr;</a>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var productId = {{ product.id | json }};
  var card = document.getElementById('tv-card-' + productId);
  if (!card) return;

  var ctxEl = card.querySelector('[data-tv-product-context]');
  var ctx;
  try { ctx = JSON.parse(ctxEl.textContent); } catch (e) { return; }

  // DOM refs
  var fileInput = document.getElementById('tv-file-input-' + productId);
  var dropzone = document.getElementById('tv-dropzone-' + productId);
  var previewWrap = document.getElementById('tv-preview-' + productId);
  var previewImg = document.getElementById('tv-preview-img-' + productId);
  var removeBtn = document.getElementById('tv-remove-photo-' + productId);
  var tryBtn = document.getElementById('tv-try-button-' + productId);
  var btnText = document.getElementById('tv-button-text-' + productId);
  var statusEl = document.getElementById('tv-status-' + productId);
  var resultContainer = document.getElementById('tv-result-container-' + productId);
  var resultImg = document.getElementById('tv-result-img-' + productId);
  var downloadLink = document.getElementById('tv-download-link-' + productId);

  var personBase64 = null;
  var loading = false;

  // ---- File upload handling ----
  dropzone.addEventListener('click', function () { fileInput.click(); });
  dropzone.addEventListener('dragover', function (e) { e.preventDefault(); dropzone.style.borderColor = 'var(--tv-accent)'; dropzone.style.background = '#eff6ff'; });
  dropzone.addEventListener('dragleave', function (e) { e.preventDefault(); dropzone.style.borderColor = '#cbd5e1'; dropzone.style.background = '#f8fafc'; });
  dropzone.addEventListener('drop', function (e) {
    e.preventDefault();
    dropzone.style.borderColor = '#cbd5e1';
    dropzone.style.background = '#f8fafc';
    handleFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', function () { handleFiles(fileInput.files); });

  function handleFiles(files) {
    if (!files || files.length === 0) return;
    var file = files[0];
    if (!file.type.match(/^image\/(jpeg|jpg|png)$/)) {
      setStatus('Please upload a JPG or PNG image.', true);
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      setStatus('Image must be under 8MB.', true);
      return;
    }
    var reader = new FileReader();
    reader.onload = function (e) {
      personBase64 = e.target.result;
      previewImg.src = personBase64;
      previewWrap.style.display = 'block';
      dropzone.style.display = 'none';
      setStatus('Photo ready. Tap Generate Try-On.');
      tryBtn.disabled = false;
    };
    reader.readAsDataURL(file);
  }

  removeBtn.addEventListener('click', function () {
    personBase64 = null;
    previewWrap.style.display = 'none';
    dropzone.style.display = 'flex';
    fileInput.value = '';
    resultContainer.style.display = 'none';
    setStatus('Photo removed.');
  });

  // ---- Variant / price / garment sync ----
  function applyVariant(id) {
    id = String(id);
    for (var i = 0; i < ctx.variants.length; i++) {
      var v = ctx.variants[i];
      if (String(v.id) === id) {
        card.setAttribute('data-tv-variant-id', v.id);
        card.setAttribute('data-tv-price-cents', v.price);
        card.setAttribute('data-tv-price-formatted', v.priceFormatted);
        document.getElementById('tv-garment-name-' + productId).textContent = v.title;
        document.getElementById('tv-garment-price-' + productId).textContent = v.priceFormatted;
        if (v.imageUrl) {
          card.setAttribute('data-tv-garment-url', v.imageUrl);
        }
        card.dispatchEvent(new CustomEvent('tryvtri:variant-change', { bubbles: true, detail: v }));
        return;
      }
    }
  }

  function currentVariantId() {
    var m = window.location.search.match(/[?&]variant=(\d+)/);
    if (m) return m[1];
    var input = document.querySelector('form[action*="/cart/add"] [name="id"]');
    return input ? input.value : null;
  }

  function initVariant() {
    var id = currentVariantId() || ctx.selectedVariantId;
    applyVariant(id);
  }

  document.addEventListener('change', function () { var id = currentVariantId(); if (id) applyVariant(id); });
  document.addEventListener('variant:change', function (e) {
    var id = (e.detail && e.detail.variant && e.detail.variant.id) || currentVariantId();
    if (id) applyVariant(id);
  });
  window.addEventListener('popstate', function () { var id = currentVariantId(); if (id) applyVariant(id); });
  var _rs = history.replaceState;
  history.replaceState = function () {
    var r = _rs.apply(this, arguments);
    var id = currentVariantId(); if (id) applyVariant(id);
    return r;
  };

  initVariant();

  // ---- Try-on request ----
  function setStatus(msg, isError) {
    statusEl.textContent = msg;
    statusEl.style.color = isError ? '#dc2626' : '#64748b';
  }

  tryBtn.addEventListener('click', function () {
    if (loading) return;
    if (!personBase64) {
      setStatus('Please upload your photo first.', true);
      return;
    }
    var garmentUrl = card.getAttribute('data-tv-garment-url') || ctx.garmentUrl;
    if (!garmentUrl) {
      setStatus('No garment image available for this product.', true);
      return;
    }

    loading = true;
    tryBtn.disabled = true;
    btnText.textContent = 'Generating...';
    resultContainer.style.display = 'none';
    setStatus('Contacting fal.ai... this usually takes 20-60 seconds.');

    var payload = {
      image_base64: personBase64,
      garment_url: garmentUrl,
      prompt: "A person wearing the garment, virtual try-on, photorealistic, high detail",
      guidance_scale: 2.5,
      num_inference_steps: 40,
      acceleration: "regular",
      enable_safety_checker: true,
      output_format: "png",
      num_images: 1,
      lora_scale: 1,
      sync_mode: false
    };

    var endpoint = card.getAttribute('data-tv-endpoint') || '/api/try-on';

    fetch(endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
    .then(function (resp) {
      if (!resp.ok) return resp.text().then(function (t) { throw new Error(t || resp.status); });
      return resp.json();
    })
    .then(function (data) {
      loading = false;
      tryBtn.disabled = false;
      btnText.textContent = 'Generate Try-On';
      if (data.images && data.images.length > 0 && data.images[0].url) {
        resultImg.src = data.images[0].url;
        downloadLink.href = data.images[0].url;
        resultContainer.style.display = 'block';
        setStatus('Try-on complete!');
        card.dispatchEvent(new CustomEvent('tryvtri:result', { bubbles: true, detail: data }));
      } else {
        setStatus('No image returned from fal.ai.', true);
      }
    })
    .catch(function (err) {
      loading = false;
      tryBtn.disabled = false;
      btnText.textContent = 'Generate Try-On';
      setStatus('Error: ' + (err.message || 'try-on failed'), true);
      console.error('tryvtri error', err);
    });
  });
})();
</script>
{%- endif -%}
