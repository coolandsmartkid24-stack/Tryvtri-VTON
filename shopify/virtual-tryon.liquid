{%- comment %}
  TryVtri Virtual Try-On — Shopify Custom Liquid block (fal.ai powered)
  Paste into: Shopify Theme Editor > Product page > Add block > Custom Liquid

  Endpoint: Vercel FastAPI proxy at https://tryvtri-vton.vercel.app/api/try-on
  - Runs fal-ai/flux-2-lora-gallery/virtual-tryon on fal's cloud GPUs
  - FAL_KEY stays server-side (never in browser)
  - CORS enabled (OPTIONS preflight + all responses)
{%- endcomment -%}

{%- assign vto_variant = product.selected_or_first_available_variant -%}
{%- assign vto_api = 'https://tryvtri-vton.vercel.app' -%}

{%- assign vto_category = '' -%}
{%- for tag in product.tags -%}
  {%- assign tag_l = tag | downcase -%}
  {%- if tag_l contains 'vto:' -%}
    {%- assign vto_category = tag_l | remove: 'vto:' | strip -%}
  {%- endif -%}
{%- endfor -%}

{%- if vto_category == '' -%}
  {%- capture vto_haystack -%}{{ product.type }} {{ product.title }} {{ product.tags | join: ' ' }}{%- endcapture -%}
  {%- assign vto_haystack = vto_haystack | downcase -%}
  {%- if vto_haystack contains 'sunglass' or vto_haystack contains 'glasses' or vto_haystack contains 'eyewear' or vto_haystack contains 'hat' or vto_haystack contains 'cap' or vto_haystack contains 'jewel' or vto_haystack contains 'necklace' or vto_haystack contains 'earring' -%}
    {%- assign vto_category = 'accessories' -%}
  {%- elsif vto_haystack contains 'dress' or vto_haystack contains 'gown' or vto_haystack contains 'jumpsuit' or vto_haystack contains 'maxi' -%}
    {%- assign vto_category = 'dresses' -%}
  {%- elsif vto_haystack contains 'jacket' or vto_haystack contains 'coat' or vto_haystack contains 'blazer' or vto_haystack contains 'hoodie' -%}
    {%- assign vto_category = 'outerwear' -%}
  {%- elsif vto_haystack contains 'pant' or vto_haystack contains 'jean' or vto_haystack contains 'skirt' or vto_haystack contains 'short' or vto_haystack contains 'trouser' -%}
    {%- assign vto_category = 'bottoms' -%}
  {%- else -%}
    {%- assign vto_category = 'tops' -%}
  {%- endif -%}
{%- endif -%}

{%- assign vto_garment_url = '' -%}
{%- if vto_variant.featured_image -%}
  {%- assign vto_garment_url = vto_variant.featured_image | image_url: width: 1024 -%}
{%- elsif product.featured_image -%}
  {%- assign vto_garment_url = product.featured_image | image_url: width: 1024 -%}
{%- endif -%}

<style>
  .tv-wrap{margin:16px 0;font-family:inherit;box-sizing:border-box;max-width:100%}
  .tv-wrap *{box-sizing:border-box}
  .tv-btn{display:flex;align-items:center;gap:14px;width:100%;padding:14px 18px;border:1px solid #16130f;border-radius:8px;background:#fff6e5;box-shadow:3px 3px 0 #16130f;cursor:pointer;text-align:left;font-family:inherit}
  .tv-btn b{display:block;font-size:18px;color:#16130f}
  .tv-btn small{font-size:13px;color:#6f6a61}
  .tv-ico{width:44px;height:44px;border-radius:8px;background:#2563eb;color:#fff;display:inline-flex;align-items:center;justify-content:center;flex:none}
  .tv-credit{font-size:11px;color:#888;margin-top:6px}
  .tv-credit a{color:inherit}
  .tv-modal{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;align-items:center;justify-content:center;z-index:2147483000;padding:16px;font-family:inherit}
  .tv-modal *{box-sizing:border-box}
  .tv-modal.open{display:flex}
  .tv-dialog{background:#fff;color:#16130f;border-radius:12px;max-width:560px;width:100%;max-height:92vh;overflow:auto;padding:20px;position:relative}
  .tv-close{position:absolute;top:10px;right:14px;border:0;background:none;font-size:26px;cursor:pointer;line-height:1;color:#16130f}
  .tv-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:14px 0}
  .tv-grid img{width:100%;border-radius:8px;border:1px solid #ddd;aspect-ratio:3/4;object-fit:cover;background:#f4f4f4}
  .tv-grid img[hidden]{display:none}
  .tv-cta{display:block;width:100%;padding:12px;border:0;border-radius:8px;background:#16130f;color:#fff;font-size:16px;cursor:pointer;margin-top:8px}
  .tv-cta[hidden]{display:none}
  .tv-cta[disabled]{opacity:.5;cursor:not-allowed}
  .tv-cta.alt{background:#2563eb}
  .tv-msg{font-size:14px;margin-top:10px;min-height:20px}
  .tv-msg.err{color:#b00020}
</style>

<div class="tv-wrap" id="tv-{{ product.id }}"
     data-api="{{ vto_api }}"
     data-shop="{{ shop.permanent_domain }}"
     data-product-id="{{ product.id }}"
     data-product-title="{{ product.title | escape }}"
     data-category="{{ vto_category }}"
     data-variant-id="{{ vto_variant.id }}"
     data-available="{{ vto_variant.available }}"
     data-garment-url="{{ vto_garment_url }}"
     data-price-cents="{{ vto_variant.price }}"
     data-price-formatted="{{ vto_variant.price | money | strip_html | escape }}"
     data-currency="{{ cart.currency.iso_code | default: shop.currency }}">

  <button type="button" class="tv-btn" data-open aria-haspopup="dialog">
    <span class="tv-ico">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4"/><circle cx="12" cy="10.2" r="2.6"/><path d="M7.6 18c.6-2.6 2.4-4 4.4-4s3.8 1.4 4.4 4"/></svg>
    </span>
    <span><b>Try It On Me</b><small>See this {% if vto_category == 'accessories' %}item{% else %}garment{% endif %} on your photo in seconds</small></span>
  </button>
  <div class="tv-credit">Powered by <a href="https://fit.tryvtri.com/" target="_blank" rel="noopener">TryVtri</a></div>

  <div class="tv-modal" data-modal role="dialog" aria-modal="true" aria-label="Virtual try-on">
    <div class="tv-dialog">
      <button type="button" class="tv-close" data-close aria-label="Close">&times;</button>
      <h3 style="margin:0 0 4px">{{ product.title }}</h3>
      <p style="margin:0;font-size:14px;color:#555">Upload a clear, front-facing, full-body photo.</p>
      <input type="file" accept="image/jpeg,image/png,image/webp" data-file style="margin-top:12px">
      <div class="tv-grid">
        <img data-person alt="Your photo" hidden>
        <img data-result alt="Try-on result" hidden>
      </div>
      <button type="button" class="tv-cta" data-run disabled>Generate try-on</button>
      <button type="button" class="tv-cta alt" data-cart hidden>Add to cart &ndash; <span data-price></span></button>
      <div class="tv-msg" data-msg aria-live="polite"></div>
    </div>
  </div>
</div>

  <script type="application/json" id="tv-ctx-{{ product.id }}">
    {
      "variants": [
        {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "price": {{ variant.price | json }},
          "priceFormatted": {{ variant.price | money | strip_html | json }},
          "available": {{ variant.available | json }},
          "imageUrl": {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 1024 | json }}{%- elsif product.featured_image -%}{{ product.featured_image | image_url: width: 1024 | json }}{%- else -%}null{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <script>
  (function () {
    var root = document.getElementById('tv-{{ product.id }}');
    if (!root) { console.error('[TryVtri] root not found'); return; }
    var $ = function (s) { return root.querySelector(s); };

    var modal = $('[data-modal]'), file = $('[data-file]'), run = $('[data-run]'),
        cartBtn = $('[data-cart]'), msg = $('[data-msg]'),
        personImg = $('[data-person]'), resultImg = $('[data-result]'),
        priceEl = $('[data-price]');

    var ctx = { variants: [] };
    try { ctx = JSON.parse(document.getElementById('tv-ctx-{{ product.id }}').textContent); }
    catch (e) { console.warn('[TryVtri] variant data unavailable', e); }

    var photoDataUrl = null, resultReady = false;

    function say(t, err) { msg.textContent = t || ''; msg.className = 'tv-msg' + (err ? ' err' : ''); }
    function isAvailable() { return root.dataset.available === 'true'; }
    function refreshCartBtn() { cartBtn.hidden = !(resultReady && isAvailable()); }

  $('[data-open]').addEventListener('click', function () {
    if (modal.parentNode !== document.body) document.body.appendChild(modal);
    priceEl.textContent = root.dataset.priceFormatted;
    modal.classList.add('open');
  });
  function close() { modal.classList.remove('open'); }
  $('[data-close]').addEventListener('click', close);
  modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });

  file.addEventListener('change', function () {
    var f = file.files[0] || null;
    if (!f) { photoDataUrl = null; run.disabled = true; return; }
    if (f.size > 10 * 1024 * 1024) { say('Photo is too large (max 10 MB).', true); photoDataUrl = null; run.disabled = true; return; }
    var reader = new FileReader();
    reader.onload = function (e) {
      photoDataUrl = e.target.result;
      personImg.src = photoDataUrl; personImg.hidden = false;
      run.disabled = false; say('');
    };
    reader.readAsDataURL(f);
  });

  // Portrait of robustness: accept a bare domain OR a value that already includes /api/try-on
  var API_BASE = (root.dataset.api || 'https://tryvtri-vton.vercel.app').trim().replace(/\/+$/, '');
  API_BASE = API_BASE.replace(/\/(api\/try-on|try-on)$/, '');

  run.addEventListener('click', async function () {
    if (!photoDataUrl) return;
    run.disabled = true; resultReady = false; refreshCartBtn(); resultImg.hidden = true;
    say('Generating your try-on… this can take 20–60 seconds.');

    function toAbsoluteUrl(u) {
      if (!u) return '';
      u = u.trim();
      if (u.indexOf('//') === 0) return 'https:' + u;
      if (u.indexOf('http://') === 0 || u.indexOf('https://') === 0) return u;
      try { return new URL(u, location.origin).href; } catch (e) { return 'https://' + u.replace(/^\/+/, ''); }
    }

    var garmentUrl = toAbsoluteUrl(root.dataset.garmentUrl);
    console.log('[TryVtri] garment URL:', garmentUrl);
    if (!garmentUrl) {
      say('No garment image available for this product.', true);
      run.disabled = false;
      return;
    }

    try {
      var payload = {
        image_base64: photoDataUrl,
        garment_url: garmentUrl,
        prompt: "A person wearing the garment, virtual try-on, photorealistic, high detail",
        guidance_scale: 2.5,
        num_inference_steps: 40,
        acceleration: "regular",
        enable_safety_checker: true,
        output_format: "png",
        num_images: 1,
        lora_scale: 1,
        sync_mode: false
      };

      var res = await fetch(API_BASE + '/api/try-on', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      var raw = await res.text();
      var data = {};
      try { data = JSON.parse(raw); } catch (e) { console.warn('[TryVtri] non-JSON response:', raw.slice(0, 300)); }
      console.log('[TryVtri] response', res.status, data);

      if (!res.ok) {
        var detail = data.error || data.message;
        if (!detail && data.detail) detail = (typeof data.detail === 'string') ? data.detail : JSON.stringify(data.detail);
        throw new Error(detail || ('Request failed (' + res.status + ')'));
      }

      var images = data.images || [];
      var out = null;
      if (images.length > 0 && images[0].url) out = images[0].url;
      if (!out) throw new Error('No image returned from the try-on service.');

      resultImg.src = out; resultImg.hidden = false;
      resultReady = true; refreshCartBtn(); say('');
    } catch (err) {
      console.error('[TryVtri]', err);
      var m = err && err.message || '';
      if (m === 'Failed to fetch') m = 'Could not reach the try-on service. Check your connection and try again.';
      say(m || 'Something went wrong. Please try again.', true);
    } finally {
      run.disabled = false;
    }
  });

  cartBtn.addEventListener('click', async function () {
    cartBtn.disabled = true;
    try {
      var base = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
      var r = await fetch(base + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(root.dataset.variantId), quantity: 1 }] })
      });
      if (!r.ok) throw new Error('Could not add to cart');
      say('Added to cart!');
      document.dispatchEvent(new CustomEvent('cart:refresh'));
    } catch (e) { say(e.message, true); }
    cartBtn.disabled = false;
  });

  // ---- universal variant / price / garment sync (theme-agnostic, no tokens) ----
  function applyVariant(id) {
    id = String(id);
    for (var i = 0; i < ctx.variants.length; i++) {
      var v = ctx.variants[i];
      if (String(v.id) === id) {
        root.dataset.variantId = v.id;
        root.dataset.priceCents = v.price;
        root.dataset.priceFormatted = v.priceFormatted;
        root.dataset.available = String(v.available);
        if (v.imageUrl) root.dataset.garmentUrl = v.imageUrl;
        priceEl.textContent = v.priceFormatted;
        refreshCartBtn();
        return;
      }
    }
  }
  function currentId() {
    var m = location.search.match(/[?&]variant=(\d+)/);
    if (m) return m[1];
    var sv = document.querySelector('[data-selected-variant]');
    if (sv) { var val = sv.getAttribute('data-selected-variant') || sv.value; if (val) return String(val); }
    var form = document.querySelector('form[action*="/cart/add"]');
    if (form) {
      var sel = form.querySelector('select[name="id"]'); if (sel && sel.value) return sel.value;
      var inp = form.querySelector('input[name="id"]'); if (inp && inp.value) return inp.value;
      var rad = form.querySelector('input[name="id"]:checked'); if (rad) return rad.value;
    }
    return null;
  }
  function syncFromDom() { var id = currentId(); if (id) applyVariant(id); }

  document.addEventListener('change', syncFromDom);
  document.addEventListener('variant:change', function (e) {
    var id = (e.detail && e.detail.variant && e.detail.variant.id) || currentId();
    if (id) applyVariant(id);
  });
  document.addEventListener('product:variant-change', function (e) {
    var id = (e.detail && (e.detail.variantId || e.detail.id)) || currentId();
    if (id) applyVariant(id);
  });
  window.addEventListener('popstate', syncFromDom);
  var rs = history.replaceState;
  history.replaceState = function () { var r = rs.apply(this, arguments); syncFromDom(); return r; };
  var svNode = document.querySelector('[data-selected-variant]');
  if (svNode && window.MutationObserver) {
    new MutationObserver(syncFromDom).observe(svNode, { attributes: true, attributeFilter: ['data-selected-variant'] });
  }
})();
</script>
{%- endif -%}
